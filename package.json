{
  "name": "don-oogiri",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm --filter @don-oogiri/engine test",
    "test:run": "pnpm --filter @don-oogiri/engine test:run",
    "dev": "concurrently -n server,mc-ui,audience-ui -c blue,magenta,green \"pnpm:dev:server\" \"pnpm:dev:mc-ui\" \"pnpm:dev:audience-ui\"",
    "dev:server": "pnpm --filter @don-oogiri/server dev",
    "dev:mc-ui": "pnpm --filter @don-oogiri/mc-ui dev",
    "dev:audience-ui": "pnpm --filter @don-oogiri/audience-ui dev",
    "build": "pnpm -r build",
    "tauri:dev": "pnpm --filter @don-oogiri/mc-ui tauri dev",
    "tauri:build": "pnpm --filter @don-oogiri/mc-ui tauri build",
    "demo": "tsx scripts/demo.ts",
    "demo:publish": "tsx scripts/demo-publish.ts",
    "demo:typecheck": "tsc --noEmit -p e2e/demo/tsconfig.json",
    "demo:test": "tsx --test e2e/demo/support/*.test.ts"
  },
  "devDependencies": {
    "@don-oogiri/engine": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "concurrently": "^9.1.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
